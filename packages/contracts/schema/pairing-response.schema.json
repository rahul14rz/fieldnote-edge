{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rahul14rz/fieldnote-edge/contracts/pairing-response.schema.json",
  "title": "PairingResponse",
  "description": "The device credential issued at pairing. The phone stores deviceSecret in secure storage; the gateway keeps only its hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deviceId",
    "deviceSecret"
  ],
  "properties": {
    "deviceId": {
      "type": "string",
      "pattern": "^dev_[0-9a-f]{32}$"
    },
    "deviceSecret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "32 random bytes, base64url without padding."
    }
  }
}
