{
  "name": "@fieldnote/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schema/*": "./schema/*",
    ".": "./generated/ts/index.ts",
    "./prompts/*": "./prompts/*"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/generate.mjs --check",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "validate-outputs": "node scripts/validate-outputs.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "quicktype": "26.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
